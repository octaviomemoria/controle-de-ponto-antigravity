{
  "name": "@controle/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Aplicativo desktop do Controle de Ponto OM Way",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:web": "npm run build -w @controle/web",
    "dist": "npm run build:web && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.omway.controleponto.desktop",
    "productName": "Controle de Ponto OM Way",
    "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs"],
    "extraResources": [
      { "from": "../web/dist", "to": "web-dist", "filter": ["**/*"] }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon-official.ico",
      "signAndEditExecutable": true
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
